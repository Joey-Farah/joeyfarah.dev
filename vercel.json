{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/((?!api|healthz|sitemap.xml|assets|images|favicon|robots.txt).*)", "destination": "/index.html" }
  ]
}
